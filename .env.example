# ========================================
# Notezilla Server Configuration
# Supabase PostgreSQL Backend
# ========================================

# Server Port
PORT=5000

# JWT Configuration
JWT_SECRET=your_secure_jwt_secret_key_here_change_in_production

# ========================================
# SUPABASE CONFIGURATION
# ========================================
# Get these from your Supabase project dashboard
# https://app.supabase.com/project/[project-id]/settings/api

# Your Supabase project URL
SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase anonymous/public API key
SUPABASE_ANON_KEY=eyJhbGc...your_anon_key_here...

# Optional: Service role key (for admin operations)
# SUPABASE_SERVICE_KEY=eyJhbGc...your_service_key...

# ========================================
# EMAIL CONFIGURATION (Optional for Phase 2)
# ========================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# ========================================
# FILE STORAGE (Optional)
# ========================================
# AWS S3 (uncomment to use)
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_S3_BUCKET=notezilla-storage
# AWS_S3_REGION=us-east-1

# Firebase (uncomment to use)
# FIREBASE_PROJECT_ID=your_firebase_project
# FIREBASE_PRIVATE_KEY=your_firebase_key
# FIREBASE_CLIENT_EMAIL=your_firebase_email
