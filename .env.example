# Railway backend
NODE_ENV=production
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
JWT_SECRET=replace-with-a-long-random-secret
GEMINI_API_KEY=
GEMINI_TIMETABLE_MODEL=gemini-2.5-flash
FACULTY_TIMEZONE=Asia/Kolkata
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3-8b-instruct:free
GOOGLE_DRIVE_ROOT_FOLDER_ID=
WANDBOX_API_URL=https://wandbox.org/api
WANDBOX_TIMEOUT_MS=45000
WANDBOX_MAX_RETRIES=2

# Exact Vercel frontend origins allowed to call Railway. Separate multiple
# preview/custom domains with commas.
FRONTEND_URL=https://your-notezilla-project.vercel.app
CORS_ORIGINS=https://notezilla.example.com

# Vercel frontend build only. Set this in Vercel, not Railway.
RAILWAY_BACKEND_URL=https://your-notezilla-backend.up.railway.app
